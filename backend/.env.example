# ---- bắt buộc
APP_TOKEN=doi-thanh-chuoi-ngau-nhien-dai
# URL public của backend (để Strava/COROS redirect về). Dùng Cloudflare Tunnel / Tailscale Funnel / ngrok.
PUBLIC_URL=https://runners.example.com
TIMEZONE=Asia/Ho_Chi_Minh
LATITUDE=10.7769
LONGITUDE=106.7009
SYNC_INTERVAL_MINUTES=30

# ---- Strava (tạo app tại https://www.strava.com/settings/api, Authorization Callback Domain = domain của PUBLIC_URL)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=runners-verify
STRAVA_WRITE_DESCRIPTIONS=false

# ---- Garmin Connect (không chính thức, chỉ dùng cá nhân). Có thể để trống và đăng nhập trong app.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_PUSH_WORKOUTS=true

# ---- COROS (Build on COROS MCP, OAuth 1 người dùng)
COROS_MCP_URL=https://mcp.coros.com/mcp
COROS_PUSH_WORKOUTS=true
# Ghim tên tool nếu tự nhận diện sai (xem GET /api/integrations/coros/tools)
COROS_TOOL_LIST_ACTIVITIES=
COROS_TOOL_CREATE_WORKOUT=

# ---- AI coach (tùy chọn)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
