{
  "expo": {
    "name": "Runners",
    "slug": "runners",
    "scheme": "runners",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.personal.runners",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dùng GPS để đo quãng đường và pace khi chạy theo hướng dẫn.",
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "package": "dev.personal.runners",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dùng GPS để đo quãng đường và pace khi chạy theo hướng dẫn."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Đọc các buổi chạy, nhịp tim, HRV và giấc ngủ để điều chỉnh giáo án.",
          "NSHealthUpdateUsageDescription": "Lưu buổi chạy ghi bằng điện thoại vào Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
